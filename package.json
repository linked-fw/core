{
  "name": "@_linked/core",
  "version": "2.22.2",
  "packageManager": "npm@11.19.1",
  "license": "MIT",
  "linkedPackage": true,
  "type": "module",
  "description": "Linked.js core query and SHACL shape DSL (copy-then-prune baseline)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linked-fw/core.git"
  },
  "main": "lib/esm/index.js",
  "module": "lib/esm/index.js",
  "sideEffects": [
    "**/ontologies/*.js",
    "**/ontologies/*.ts",
    "**/utils/Package.js",
    "**/utils/Package.ts"
  ],
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
      "import": "./lib/esm/index.js"
    },
    "./sparql": {
      "types": "./lib/esm/sparql/index.d.ts",
      "import": "./lib/esm/sparql/index.js"
    },
    "./*": {
      "types": "./lib/esm/*.d.ts",
      "import": "./lib/esm/*.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "lib",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rimraf ./lib && tsc -p tsconfig-esm.json",
    "compile": "echo '💫 Compiling ESM' && tsc -p tsconfig-esm.json",
    "sync:agents": "node packages/skills/sync.mjs",
    "setup": "npx semantu-agents",
    "typecheck": "tsc -p tsconfig-tests.json",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs && npm run typecheck",
    "test:fuseki": "docker compose -f src/tests/docker-compose.test.yml up -d --wait && NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs --runInBand --testPathPattern='sparql-fuseki' --verbose; EXIT=$?; docker compose -f src/tests/docker-compose.test.yml down; exit $EXIT"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "jest": "^29.7.0",
    "rimraf": "^5.0.7",
    "ts-jest": "^29.1.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "ulid": "^3.0.2"
  },
  "types": "index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "lib/esm/*"
      ]
    }
  }
}
