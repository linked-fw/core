{
  "name": "@_linked/core",
  "version": "2.45.0",
  "packageManager": "npm@12.2.0",
  "license": "MIT",
  "linked": {
    "kind": "library"
  },
  "type": "module",
  "description": "Linked.js core query and SHACL shape DSL (copy-then-prune baseline)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linked-fw/core.git"
  },
  "main": "lib/esm/index.js",
  "module": "lib/esm/index.js",
  "sideEffects": [
    "**/ontologies/*.js",
    "**/ontologies/*.ts",
    "**/utils/Package.js",
    "**/utils/Package.ts",
    "**/lib/esm/index.js",
    "**/src/index.ts",
    "**/lib/esm/live.js",
    "**/src/live.ts",
    "**/lib/esm/live/LiveQueryStore.js",
    "**/src/live/LiveQueryStore.ts",
    "**/shapes/index.js",
    "**/shapes/index.ts",
    "**/shapes/*.js",
    "**/shapes/*.ts"
  ],
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
      "import": "./lib/esm/index.js"
    },
    "./sparql": {
      "types": "./lib/esm/sparql/index.d.ts",
      "import": "./lib/esm/sparql/index.js"
    },
    "./ontology/loadOntologyFiles": {
      "types": "./lib/esm/ontology/loadOntologyFiles.d.ts",
      "react-native": "./lib/esm/ontology/loadOntologyFiles.browser.js",
      "browser": "./lib/esm/ontology/loadOntologyFiles.browser.js",
      "import": "./lib/esm/ontology/loadOntologyFiles.js",
      "default": "./lib/esm/ontology/loadOntologyFiles.js"
    },
    "./ontology/loadOntologyFiles.js": {
      "types": "./lib/esm/ontology/loadOntologyFiles.d.ts",
      "react-native": "./lib/esm/ontology/loadOntologyFiles.browser.js",
      "browser": "./lib/esm/ontology/loadOntologyFiles.browser.js",
      "import": "./lib/esm/ontology/loadOntologyFiles.js",
      "default": "./lib/esm/ontology/loadOntologyFiles.js"
    },
    "./*.js": {
      "types": "./lib/esm/*.d.ts",
      "import": "./lib/esm/*.js"
    },
    "./*": {
      "types": "./lib/esm/*.d.ts",
      "import": "./lib/esm/*.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "lib",
    "!lib/esm/tests",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "linked build",
    "compile": "echo '💫 Compiling ESM' && tsc -p tsconfig-esm.json",
    "sync:agents": "node packages/skills/sync.mjs",
    "setup": "npx semantu-agents",
    "typecheck": "tsc -p tsconfig-tests.json",
    "check:dts": "tsc -p tsconfig-dts-check.json",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs && npm run typecheck",
    "test:ci": "[ \"$GITHUB_ACTIONS\" = true ] || { echo 'test:ci runs only on GitHub Actions. Locally: export FUSEKI_BASE_URL and FUSEKI_ADMIN_PASSWORD for a Fuseki of your own, then npm test.' >&2; exit 1; } && FUSEKI_BASE_URL=http://localhost:3939 FUSEKI_ADMIN_PASSWORD=admin npm test",
    "test:fuseki": "REQUIRE_FUSEKI=1 NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs --testNamePattern='\\[fuseki\\]'"
  },
  "devDependencies": {
    "@_linked/cli": "^1.54.0",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@jest/globals": "^30.0.0",
    "@types/jest": "^30.0.0",
    "@types/n3": "^1.26.4",
    "@types/node": "^24.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "n3": "^2.13.12",
    "ulid": "^3.0.2"
  },
  "types": "index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "lib/esm/*"
      ]
    }
  }
}
