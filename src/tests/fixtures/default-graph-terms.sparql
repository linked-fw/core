    ?h4 <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest>* ?c4 . FILTER(isBlank(?c4))
    ?c4 ?q5 ?h5 . FILTER(isBlank(?h5))
    ?h5 <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest>* ?c5 . FILTER(isBlank(?c5))
    ?c5 ?q6 ?h6 . FILTER(isBlank(?h6))
    ?h6 <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest>* ?c6 . FILTER(isBlank(?c6))
    ?c6 ?q7 ?h7 . FILTER(isBlank(?h7))
    ?h7 <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest>* ?c7 . FILTER(isBlank(?c7))
    ?c7 ?q8 ?h8 . FILTER(isBlank(?h8))
    ?h8 <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest>* ?d . FILTER(isBlank(?d))
    ?d ?dp ?do .
  }
} ;
INSERT DATA {
<http://example.org/ont/A> <http://www.w3.org/2000/01/rdf-schema#label> "A" .
}
