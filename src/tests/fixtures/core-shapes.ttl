@prefix core: <https://linked.cm/ont/core/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://linked.cm/shape/core/DraftGraph>
  a sh:NodeShape ;
  rdfs:comment "The registry record of a draft graph a dataset owns. (graph registry, draft graph)" ;
  sh:targetClass core:DraftGraph ;
  core:isExtending <https://linked.cm/shape/core/NamedGraph> .

<https://linked.cm/shape/core/List>
  a sh:NodeShape ;
  sh:property <https://linked.cm/shape/core/List/first> ;
  sh:property <https://linked.cm/shape/core/List/rest> ;
  sh:targetClass rdf:List .

<https://linked.cm/shape/core/List/first>
  a sh:PropertyShape ;
  rdfs:label "first" ;
  sh:maxCount "1"^^xsd:integer ;
  sh:path rdf:first .

<https://linked.cm/shape/core/List/rest>
  a sh:PropertyShape ;
  rdfs:label "rest" ;
  sh:maxCount "1"^^xsd:integer ;
  sh:node <https://linked.cm/shape/core/List> ;
  sh:nodeKind sh:IRI ;
  sh:path rdf:rest ;
  core:contains "true"^^xsd:boolean .

<https://linked.cm/shape/core/NamedGraph>
  a sh:NodeShape ;
  rdfs:comment "A named graph's record in the graph registry: name, content hash, load time, sources, whether it feeds the class hierarchy. (graph registry, named graph)" ;
  sh:property <https://linked.cm/shape/core/NamedGraph/contentHash> ;
  sh:property <https://linked.cm/shape/core/NamedGraph/feedsHierarchy> ;
  sh:property <https://linked.cm/shape/core/NamedGraph/modified> ;
  sh:property <https://linked.cm/shape/core/NamedGraph/name> ;
  sh:property <https://linked.cm/shape/core/NamedGraph/sources> ;
